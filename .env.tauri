# Environment for the desktop (Tauri) build — loaded via `vite build --mode tauri`.
# Points every WASM module at the locally-bundled copies under /wasm so the
# desktop app runs fully offline with no CDN dependency. These files are copied
# into dist/wasm by scripts/copy-wasm-to-dist.mjs during `npm run build:tauri`.
#
# The web/LAN build ignores this file entirely.

VITE_WASM_PYMUPDF_URL=/wasm/pymupdf/
VITE_WASM_GS_URL=/wasm/gs/
VITE_WASM_CPDF_URL=/wasm/cpdf/

VITE_TESSERACT_WORKER_URL=/wasm/ocr/worker.min.js
VITE_TESSERACT_CORE_URL=/wasm/ocr/core
VITE_TESSERACT_LANG_URL=/wasm/ocr/lang-data
VITE_OCR_FONT_BASE_URL=/wasm/ocr/fonts
