        <mxCell id="pdflib" value="pdf-lib (+ fontkit)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=18.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="201.31067961165047" width="300" height="105.30097087378641" as="geometry"/></mxCell>
        <mxCell id="pdflib_d" value="Xoay, xoá và trích trang; đóng dấu chìm; đánh số trang; đầu và chân trang; gộp nhiều trang lên một tờ; làm phẳng; chuẩn hoá khổ giấy; nhúng phông và vẽ lớp văn bản cho kết quả OCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="201.31067961165047" width="760" height="105.30097087378641" as="geometry"/></mxCell>
        <mxCell id="pdfjs" value="pdf.js (pdfjs-dist)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=18.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="322.09708737864077" width="300" height="105.30097087378641" as="geometry"/></mxCell>
        <mxCell id="pdfjs_d" value="Kết xuất trang ra canvas; sinh ảnh thu nhỏ; xem trước tài liệu; trích văn bản; PDF sang ảnh; hiệu ứng bản quét; phát hiện tài liệu có mật khẩu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="322.09708737864077" width="760" height="105.30097087378641" as="geometry"/></mxCell>
