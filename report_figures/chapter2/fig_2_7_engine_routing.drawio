        <mxCell id="qpdf_d" value="Mã hoá AES-256; giải mã; đặt quyền in, sao chép và chỉnh sửa; tuyến tính hoá; sửa chữa tệp hỏng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="442.88349514563106" width="760" height="105.30097087378641" as="geometry"/></mxCell>
