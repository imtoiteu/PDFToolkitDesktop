        <mxCell id="cpdf_d" value="Ghép tệp có giữ nhãn trang; tách theo bookmark; sinh mục lục; chuyển đổi PDF ↔ JSON; thêm, sửa và trích tệp đính kèm; sửa bookmark" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="563.6699029126213" width="760" height="105.30097087378641" as="geometry"/></mxCell>
