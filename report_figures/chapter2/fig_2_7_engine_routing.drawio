        <mxCell id="gs_d" value="Chuyển đổi sang PDF/A-1b, PDF/A-2b và PDF/A-3b; chuyển phông chữ thành đường nét vector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="805.2427184466019" width="760" height="105.30097087378641" as="geometry"/></mxCell>
