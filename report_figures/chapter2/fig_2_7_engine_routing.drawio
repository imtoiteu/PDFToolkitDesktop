        <mxCell id="pymu_d" value="Nén ảnh nhúng; PDF sang văn bản, Markdown, SVG và DOCX; trích ảnh và bảng; EPUB, MOBI, FB2, XPS và CBZ sang PDF; khử nghiêng trang quét" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="684.4563106796116" width="760" height="105.30097087378641" as="geometry"/></mxCell>
