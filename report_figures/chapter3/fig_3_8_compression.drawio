<mxfile host="app.diagrams.net" agent="PDFToolkitDesktop-report" type="device">
  <diagram id="176da281610c4287" name="Hình 3.8 - Hai chiến lược nén PDF">
    <mxGraphModel dx="1160" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g1" value="Chiến lược 1 — Condense (PyMuPDF, giữ văn bản)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=24.0;fontStyle=1;opacity=55;" vertex="1" parent="1"><mxGeometry x="40.0" y="260.0" width="530.0" height="940.0" as="geometry"/></mxCell>
        <mxCell id="g2" value="Chiến lược 2 — Photon (kết xuất lại thành ảnh)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=24.0;fontStyle=1;opacity=55;" vertex="1" parent="1"><mxGeometry x="600.0" y="260.0" width="520.0" height="940.0" as="geometry"/></mxCell>
        <mxCell id="in" value="Tệp PDF đầu vào + mức nén đã chọn" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=24.0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="80.0" width="300" height="112.0" as="geometry"/></mxCell>
        <mxCell id="a1" value="performCondenseCompression(blob, level)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="66" y="360.0" width="478" height="100.0" as="geometry"/></mxCell>
        <mxCell id="a2" value="Bảng tham số CONDENSE_PRESETS&lt;br&gt;&lt;br&gt;light        chất lượng 90 · DPI đích 150 · ngưỡng 200&lt;br&gt;balanced   chất lượng 75 · DPI đích 96 · ngưỡng 150&lt;br&gt;aggressive chất lượng 50 · DPI đích 72 · ngưỡng 100&lt;br&gt;extreme    chất lượng 30 · DPI đích 60 · ngưỡng 96" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=20.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="66" y="488.0" width="478" height="260.0" as="geometry"/></mxCell>
        <mxCell id="a3" value="Thao tác: lấy mẫu lại ảnh nhúng, tuỳ chọn chuyển xám, gỡ siêu dữ liệu và ảnh thu nhỏ, tạo tập con phông (subsetFonts)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="66" y="776.0" width="478" height="152.0" as="geometry"/></mxCell>
        <mxCell id="a4" value="Lưu với garbage = 4, deflate, clean, useObjstms&lt;br&gt;Nếu lỗi: thử lại với images.enabled = false và đánh dấu usedFallback" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="66" y="956.0" width="478" height="152.0" as="geometry"/></mxCell>
        <mxCell id="b1" value="performPhotonCompression(buffer, level)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="626" y="360.0" width="468" height="100.0" as="geometry"/></mxCell>
        <mxCell id="b2" value="Bảng tham số PHOTON_PRESETS&lt;br&gt;&lt;br&gt;light        tỉ lệ 2,00 · chất lượng JPEG 0,85&lt;br&gt;balanced   tỉ lệ 1,50 · chất lượng JPEG 0,65&lt;br&gt;aggressive tỉ lệ 1,20 · chất lượng JPEG 0,45&lt;br&gt;extreme    tỉ lệ 1,00 · chất lượng JPEG 0,25" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=20.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="626" y="488.0" width="468" height="260.0" as="geometry"/></mxCell>
        <mxCell id="b3" value="Mỗi trang: pdf.js render → canvas → canvas.toBlob(&#x27;image/jpeg&#x27;) → pdf-lib embedJpg + drawImage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="626" y="776.0" width="468" height="152.0" as="geometry"/></mxCell>
        <mxCell id="b4" value="Giải phóng canvas ngay sau mỗi trang (width = height = 0)&lt;br&gt;Hệ quả: mất lớp văn bản, tài liệu trở thành ảnh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="626" y="956.0" width="468" height="152.0" as="geometry"/></mxCell>
        <mxCell id="out" value="So sánh dung lượng trước / sau và tải xuống kết quả" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=24.0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="1260.0" width="400" height="112.0" as="geometry"/></mxCell>
