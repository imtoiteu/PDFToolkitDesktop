        <mxCell id="r1_w" value="Khối finally gọi FS.unlink() cho cả hai đường dẫn, kể cả khi qpdf ném ngoại lệ; thể hiện qpdf được giữ singleton nên chỉ nạp một lần" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=20.0;" vertex="1" parent="1"><mxGeometry x="740" y="300.0" width="380" height="152.0" as="geometry"/></mxCell>
