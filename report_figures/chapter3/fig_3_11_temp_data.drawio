        <mxCell id="r2_h" value="cùng khuôn mẫu MEMFS cho chuyển PDF/A và chuyển phông thành đường nét" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=20.0;" vertex="1" parent="1"><mxGeometry x="340" y="468.0" width="380" height="152.0" as="geometry"/></mxCell>
