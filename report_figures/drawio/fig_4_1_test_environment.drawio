        <mxCell id="m1" value="Danh sách kiểm tra khói&lt;br&gt;trong DESKTOP.md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="66" y="900.0" width="190" height="132.0" as="geometry"/></mxCell>
        <mxCell id="m2" value="Chạy ngoại tuyến&lt;br&gt;(ngắt kết nối mạng)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="276" y="900.0" width="190" height="132.0" as="geometry"/></mxCell>
        <mxCell id="m3" value="Quan sát tab Network&lt;br&gt;của DevTools" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="486" y="900.0" width="190" height="132.0" as="geometry"/></mxCell>
        <mxCell id="m4" value="Kiểm tra hộp thoại lưu&lt;br&gt;native và trường hợp huỷ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="696" y="900.0" width="190" height="139.0" as="geometry"/></mxCell>
        <mxCell id="m5" value="Đổi ngôn ngữ VI ⇄ EN&lt;br&gt;và khởi động lại" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="906" y="900.0" width="190" height="132.0" as="geometry"/></mxCell>
        <mxCell id="mnote" value="Bao gồm các thao tác đại diện: Merge PDF (pdf-lib/cpdf) · JPG → PDF · Compress (Ghostscript) · PDF → PNG (PyMuPDF) · Encrypt/Decrypt (qpdf) · OCR (Tesseract, dữ liệu eng cục bộ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="66" y="1060.0" width="1030" height="100.0" as="geometry"/></mxCell>
        <mxCell id="lim" value="Giới hạn của môi trường thử nghiệm trong khuôn khổ đề tài&lt;br&gt;&lt;br&gt;Máy chủ dùng để phân tích mã nguồn không có màn hình đồ hoạ và không đủ tài nguyên đĩa/bộ nhớ để cài đặt toàn bộ phụ thuộc và biên dịch ứng dụng. Vì vậy các số liệu về thời gian xử lý, mức tiêu thụ bộ nhớ và ảnh chụp giao diện chưa được đo trực tiếp; báo cáo chỉ trình bày phương pháp đo và các tiêu chí đánh giá." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="40" y="1260.0" width="1080" height="200.0" as="geometry"/></mxCell>
