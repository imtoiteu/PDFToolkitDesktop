        <mxCell id="vt" value="&lt;b&gt;Vitest 4 + môi trường jsdom 28&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:22px&#39;&gt;cấu hình trong vite.config.ts → test&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=24.0;html=1;" vertex="1" parent="1"><mxGeometry x="66" y="184.0" width="488" height="120.0" as="geometry"/></mxCell>
        <mxCell id="setup" value="&lt;b&gt;src/tests/setup.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:22px&#39;&gt;thiết lập chung trước mỗi bộ kiểm thử&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=24.0;html=1;" vertex="1" parent="1"><mxGeometry x="66" y="328.0" width="488" height="112.0" as="geometry"/></mxCell>
