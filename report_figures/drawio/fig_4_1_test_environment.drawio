        <mxCell id="es" value="&lt;b&gt;ESLint 10 + typescript-eslint&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:22px&#39;&gt;eslint-plugin-security, eslint-plugin-no-unsanitized&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=24.0;html=1;" vertex="1" parent="1"><mxGeometry x="646" y="184.0" width="448" height="120.0" as="geometry"/></mxCell>
