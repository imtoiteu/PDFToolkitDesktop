<mxfile host="app.diagrams.net" agent="PDFToolkitDesktop-report" type="device">
  <diagram id="6bdfee62e94d4a63" name="Hình 3.7 - Giải quyết nguồn mô-đun WASM">
    <mxGraphModel dx="1160" dy="1595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1595" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="build" value="&lt;b&gt;Thời điểm biên dịch&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:23px&#39;&gt;vite build --mode tauri nạp .env.tauri&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=25.9;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="79.75" width="380" height="191.39999999999998" as="geometry"/></mxCell>
        <mxCell id="envv" value="VITE_WASM_PYMUPDF_URL=/wasm/pymupdf/&lt;br&gt;VITE_WASM_GS_URL=/wasm/gs/&lt;br&gt;VITE_WASM_CPDF_URL=/wasm/cpdf/&lt;br&gt;VITE_TESSERACT_WORKER_URL=/wasm/ocr/worker.min.js&lt;br&gt;VITE_TESSERACT_CORE_URL=/wasm/ocr/core&lt;br&gt;VITE_TESSERACT_LANG_URL=/wasm/ocr/lang-data&lt;br&gt;VITE_OCR_FONT_BASE_URL=/wasm/ocr/fonts" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontSize=19.9;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="299.0625" width="380" height="338.9375" as="geometry"/></mxCell>
        <mxCell id="wp" value="&lt;b&gt;WasmProviderManager&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:23px&#39;&gt;src/js/utils/wasm-provider.ts&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=25.9;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="79.75" width="320" height="191.39999999999998" as="geometry"/></mxCell>
        <mxCell id="order" value="Thứ tự ưu tiên khi lấy URL:&lt;br&gt;1. Giá trị người dùng đặt trong localStorage&lt;br&gt;     (khoá bentopdf:wasm-providers)&lt;br&gt;2. Giá trị ENV_DEFAULTS từ biến VITE_*&lt;br&gt;3. CDN_DEFAULTS (jsDelivr) — chỉ bản web&lt;br&gt;&lt;br&gt;Mọi URL phải thuộc BUILTIN_TRUSTED_HOSTS,&lt;br&gt;nếu không sẽ bị loại và ghi cảnh báo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=19.9;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="299.0625" width="320" height="438.875" as="geometry"/></mxCell>
        <mxCell id="loaders" value="&lt;b&gt;Các bộ nạp chuyên biệt&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:23px&#39;&gt;pymupdf-loader · ghostscript-loader · cpdf-helper · tesseract-runtime · libreoffice-loader&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=25.9;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="79.75" width="320" height="209.43125" as="geometry"/></mxCell>
        <mxCell id="cache" value="Mỗi bộ nạp giữ một thể hiện singleton&lt;br&gt;và một loadPromise dùng chung để tránh&lt;br&gt;nạp trùng khi nhiều thao tác cùng gọi.&lt;br&gt;&lt;br&gt;cpdf-helper nạp bằng thẻ &lt;script&gt;;&lt;br&gt;merge.worker.js nạp bằng importScripts()." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=19.9;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="299.0625" width="320" height="338.9375" as="geometry"/></mxCell>
        <mxCell id="disk" value="dist/wasm/ được đóng gói vào ứng dụng bởi scripts/copy-wasm-to-dist.mjs&lt;br&gt;&lt;br&gt;pymupdf/ (54 MB — Pyodide, numpy, opencv, pymupdf, pdf2docx, python-docx)   ·   ocr/ (47 MB — 8 biến thể tesseract-core, eng.traineddata.gz, NotoSans)   ·   gs/ (15 MB)   ·   cpdf/ (6 MB)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontSize=21.9;" vertex="1" parent="1"><mxGeometry x="40" y="737.6875" width="1080" height="219.3125" as="geometry"/></mxCell>
        <mxCell id="coop" value="Yêu cầu cách ly nguồn gốc&lt;br&gt;&lt;br&gt;tauri.conf.json → app.security.headers đặt&lt;br&gt;Cross-Origin-Opener-Policy: same-origin&lt;br&gt;Cross-Origin-Embedder-Policy: require-corp&lt;br&gt;→ SharedArrayBuffer khả dụng cho các mô-đun WASM đa luồng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;fontColor=#0F172A;fontSize=21.9;" vertex="1" parent="1"><mxGeometry x="40" y="1016.8125" width="530" height="263.3125" as="geometry"/></mxCell>
        <mxCell id="gate" value="Cổng kiểm tra trước khi chạy&lt;br&gt;&lt;br&gt;requireWasm(pkg) → WasmProvider.isConfigured(pkg)&lt;br&gt;Nếu thiếu: showWasmRequiredDialog() liệt kê các tính năng phụ thuộc và mở trang wasm-settings.html" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=21.9;" vertex="1" parent="1"><mxGeometry x="600" y="1016.8125" width="520" height="235.2625" as="geometry"/></mxCell>
        <mxCell id="net" value="Kết luận về phụ thuộc mạng của bản desktop&lt;br&gt;&lt;br&gt;Không có yêu cầu mạng nào cho các thao tác lõi. Hai tính năng duy nhất chủ động dùng mạng: (1) đóng dấu thời gian RFC 3161 tới máy chủ TSA do người dùng chọn; (2) tải phông chữ CJK/Noto theo yêu cầu khi OCR ngôn ngữ tương ứng. Cả hai chỉ chạy khi người dùng trực tiếp kích hoạt." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=21.9;" vertex="1" parent="1"><mxGeometry x="40" y="1295.9375" width="1080" height="219.3125" as="geometry"/></mxCell>
        <mxCell id="edge0" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;fontSize=19.9;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build" target="wp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;fontSize=19.9;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wp" target="loaders"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge2" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;fontSize=19.9;fontColor=#334155;dashed=1;dashPattern=6 4;endArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="envv" target="order"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge3" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;fontSize=19.9;fontColor=#334155;dashed=1;dashPattern=6 4;endArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="order" target="cache"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#EA580C;fontSize=19.9;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="loaders" target="disk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970.0" y="697.8" as="point"/></Array></mxGeometry></mxCell>
        <mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#334155;fontSize=19.9;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="disk" target="coop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305.0" y="986.9" as="point"/></Array></mxGeometry></mxCell>
        <mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#DC2626;fontSize=19.9;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="disk" target="gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860.0" y="986.9" as="point"/></Array></mxGeometry></mxCell>
