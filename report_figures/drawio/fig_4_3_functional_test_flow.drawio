<mxfile host="app.diagrams.net" agent="PDFToolkitDesktop-report" type="device">
  <diagram id="0cba5844636d4281" name="Hình 4.3 - Quy trình kiểm thử chức năng">
    <mxGraphModel dx="1160" dy="1520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="1.  Chuẩn bị dữ liệu thử: PDF văn bản, PDF nhiều trang, PDF quét, PDF có mật khẩu, ảnh JPG/PNG/TIFF, tài liệu văn phòng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="80.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t2" value="2.  Chọn công cụ cần kiểm thử từ màn hình làm việc hoặc mở trực tiếp trang công cụ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="216.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t3" value="3.  Nạp tệp bằng cả hai đường: hộp thoại chọn tệp của hệ điều hành và kéo–thả vào drop-zone" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="352.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t4" value="4.  Kiểm tra phản hồi giao diện: danh sách tệp, số trang, ảnh thu nhỏ, thông báo lỗi khi tệp sai định dạng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="488.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t5" value="5.  Nhập tham số biên: khoảng trang rỗng, khoảng trang không hợp lệ, mật khẩu sai, giá trị vượt số trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="624.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t6" value="6.  Thực thi và quan sát loader; với thao tác dài kiểm tra giao diện không bị treo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="760.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t7" value="7.  Kiểm tra hộp thoại lưu native: lưu thành công, huỷ hộp thoại, ghi đè tệp đã tồn tại" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="896.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t8" value="8.  Mở tệp kết quả bằng trình đọc PDF độc lập để xác nhận tính hợp lệ của tài liệu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="1032.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t9" value="9.  Lặp lại toàn bộ trong trạng thái ngắt kết nối mạng và quan sát tab Network để xác nhận không có yêu cầu ra ngoài" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="1168.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="t10" value="10.  Ghi nhận kết quả theo mẫu: mã ca, đầu vào, thao tác, kết quả mong đợi, kết quả thực tế, kết luận Đạt/Không đạt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="1304.0" width="780" height="112.0" as="geometry"/></mxCell>
        <mxCell id="cls" value="Phân loại ca kiểm thử&lt;br&gt;&lt;br&gt;• Đường đi thuận lợi&lt;br&gt;• Giá trị biên&lt;br&gt;• Đầu vào không hợp lệ&lt;br&gt;• Huỷ giữa chừng&lt;br&gt;• Tài liệu lớn" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="930" y="240.0" width="200" height="400.0" as="geometry"/></mxCell>
        <mxCell id="ev" value="Bằng chứng thu thập&lt;br&gt;&lt;br&gt;• Ảnh chụp màn hình&lt;br&gt;• Tệp kết quả&lt;br&gt;• Nhật ký console&lt;br&gt;• Danh sách yêu cầu mạng&lt;br&gt;• Dung lượng trước/sau" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="930" y="800.0" width="200" height="400.0" as="geometry"/></mxCell>
        <mxCell id="no" value="Trạng thái hiện tại: quy trình trên đã được đặc tả đầy đủ và một phần đã được phản ánh trong danh sách kiểm tra khói của DESKTOP.md, nhưng chưa được thực hiện trên ứng dụng đã đóng gói trong phạm vi đề tài này; các bảng kết quả trong Chương 4 vì vậy để trống cột &#x27;kết quả thực tế&#x27;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="10" y="1320.0" width="1140" height="140.0" as="geometry"/></mxCell>
