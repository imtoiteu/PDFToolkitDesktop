<mxfile host="app.diagrams.net" agent="PDFToolkitDesktop-report" type="device">
  <diagram id="9d1ced3871d44611" name="Hình 3.6 - Cơ chế đa ngữ và mặc định tiếng Việt">
    <mxGraphModel dx="1160" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="boot" value="&lt;b&gt;init() trong main.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:22px&#39;&gt;nếu localStorage chưa có i18nextLng thì đặt &#x27;vi&#x27;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=24.0;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80.0" width="340" height="152.0" as="geometry"/></mxCell>
        <mxCell id="res" value="&lt;b&gt;getLanguageFromUrl()&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:22px&#39;&gt;thứ tự: tiền tố URL → localStorage → navigator.languages → VITE_DEFAULT_LANGUAGE → &#x27;en&#x27;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=24.0;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="80.0" width="340" height="169.0" as="geometry"/></mxCell>
        <mxCell id="init" value="&lt;b&gt;initI18n()&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:22px&#39;&gt;i18next + HttpBackend, hai không gian tên common và tools&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=24.0;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="80.0" width="320" height="152.0" as="geometry"/></mxCell>
        <mxCell id="locales" value="public/locales/&lt;lang&gt;/common.json  ·  tools.json&lt;br&gt;&lt;br&gt;21 ngôn ngữ: en, vi, ar, be, da, de, es, fr, id, it, ja, ko, nl, pt, ru, sk, sv, tr, uk, zh, zh-TW&lt;br&gt;Bản tiếng Việt: 272 khoá trong common.json và 890 khoá trong tools.json" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="320.0" width="520" height="260.0" as="geometry"/></mxCell>
        <mxCell id="apply" value="applyTranslations()&lt;br&gt;&lt;br&gt;Duyệt mọi phần tử mang data-i18n và thay nội dung; injectLanguageSwitcher() thêm bộ chọn ngôn ngữ; setLanguageInPlace() đổi ngôn ngữ mà không tải lại trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600" y="320.0" width="520" height="260.0" as="geometry"/></mxCell>
        <mxCell id="web" value="Bản web (production)&lt;br&gt;&lt;br&gt;scripts/generate-i18n-pages.mjs sinh sẵn thư mục /vi/, /fr/, … cho từng trang; rewriteLinks() thêm tiền tố ngôn ngữ vào mọi liên kết nội bộ; sitemap và thẻ hreflang được sinh kèm" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="680.0" width="520" height="300.0" as="geometry"/></mxCell>
        <mxCell id="tauri" value="Bản desktop (Tauri)&lt;br&gt;&lt;br&gt;Không sinh trang theo ngôn ngữ. rewriteLinks() phải bỏ qua, nếu không mọi liên kết sẽ trỏ tới /vi/&lt;tool&gt;.html không tồn tại — đây chính là lỗi thẻ công cụ không bấm được ở lần tải đầu, đã sửa ở commit 4a63fa9" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=22.0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600" y="680.0" width="520" height="300.0" as="geometry"/></mxCell>
        <mxCell id="guard" value="Điều kiện bảo vệ sau khi sửa lỗi (src/js/i18n/i18n.ts)&lt;br&gt;&lt;br&gt;const isTauri = import.meta.env.MODE === &#x27;tauri&#x27; || &#x27;__TAURI_INTERNALS__&#x27; in window || &#x27;__TAURI__&#x27; in window;&lt;br&gt;if (import.meta.env.DEV || isTauri) return;   // giữ nguyên liên kết phẳng, dùng cơ chế đổi ngôn ngữ tại chỗ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="40" y="1060.0" width="1080" height="180.0" as="geometry"/></mxCell>
        <mxCell id="id" value="Nguyên tắc thiết kế bảo đảm tính ổn định&lt;br&gt;&lt;br&gt;Danh mục và công cụ được định danh bằng tên nội bộ cố định (getToolIdFromHref lấy phần tên tệp .html); chỉ nhãn hiển thị được dịch. Nhờ vậy việc đổi ngôn ngữ không làm thay đổi định danh, không ảnh hưởng tới cấu hình DISABLE_TOOLS hay config.json." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=22.0;" vertex="1" parent="1"><mxGeometry x="40" y="1300.0" width="1080" height="180.0" as="geometry"/></mxCell>
        <mxCell id="edge0" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;fontSize=20.0;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="boot" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;fontSize=20.0;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="res" target="init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge2" value="tải tài nguyên" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#059669;fontSize=20.0;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="init" target="locales"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960.0" y="280.0" as="point"/><mxPoint x="300.0" y="280.0" as="point"/></Array></mxGeometry></mxCell>
        <mxCell id="edge3" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;fontSize=20.0;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="locales" target="apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0284C7;fontSize=20.0;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apply" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860.0" y="630.0" as="point"/><mxPoint x="300.0" y="630.0" as="point"/></Array></mxGeometry></mxCell>
        <mxCell id="edge5" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#DC2626;fontSize=20.0;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apply" target="tauri"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge6" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#DC2626;fontSize=20.0;fontColor=#334155;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tauri" target="guard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
