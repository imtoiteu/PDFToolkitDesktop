        <mxCell id="legend" value="Quy ước trình bày kết quả trong Chương 4&lt;br&gt;&lt;br&gt;Tiêu chí đã có bằng chứng trực tiếp từ mã nguồn hoặc cấu hình được trình bày kèm dẫn chứng tệp và dòng lệnh. Tiêu chí cần đo trên ứng dụng đang chạy được ghi rõ là CHƯA ĐO, kèm phương pháp đo đề xuất; báo cáo không đưa ra bất kỳ con số ước lượng nào cho các tiêu chí này." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=21.9;" vertex="1" parent="1"><mxGeometry x="30" y="1395.625" width="1120" height="163.58749999999998" as="geometry"/></mxCell>
