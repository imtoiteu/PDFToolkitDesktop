        <mxCell id="fb" value="Cơ chế suy giảm nhẹ nhàng: giải mã thử CoherentPDF rồi PyMuPDF · nén thử có ảnh rồi không ảnh · phông thất bại thì dùng Helvetica · lưu native thất bại thì quay về tải xuống kiểu trình duyệt · OCR quá hạn ở một trang không làm hỏng cả tài liệu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontColor=#1E1B4B;fontSize=21.9;" vertex="1" parent="1"><mxGeometry x="30" y="1379.675" width="1105" height="139.5625" as="geometry"/></mxCell>
