        <mxCell id="n1" value="qpdf-wasm: mã hoá AES-256, đặt mật khẩu người dùng và chủ sở hữu, cờ hạn chế in/sao chép/sửa" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=20.7;" vertex="1" parent="1"><mxGeometry x="300" y="657.3170731707318" width="520" height="112.6829268292683" as="geometry"/></mxCell>
        <mxCell id="n2" value="zgapdfsigner + node-forge: ký số X.509 từ PFX/PEM, khoá riêng chỉ tồn tại trong bộ nhớ trang; đóng dấu thời gian RFC 3161" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=20.7;" vertex="1" parent="1"><mxGeometry x="300" y="788.7804878048781" width="520" height="116.43902439024392" as="geometry"/></mxCell>
        <mxCell id="n3" value="sanitize.ts: gỡ JavaScript, tệp nhúng, siêu dữ liệu, chú thích, liên kết, cây cấu trúc; redact.ts xoá vĩnh viễn nội dung" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=20.7;" vertex="1" parent="1"><mxGeometry x="240" y="1025.4146341463415" width="640" height="84.97560975609757" as="geometry"/></mxCell>
        <mxCell id="n4" value="DOMPurify + escapeHtml + sanitizeEmailHtml cho mọi nội dung do tệp cung cấp; 22 ca kiểm thử tái hiện tấn công XSS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=20.7;" vertex="1" parent="1"><mxGeometry x="240" y="1115.5609756097563" width="640" height="84.97560975609757" as="geometry"/></mxCell>
