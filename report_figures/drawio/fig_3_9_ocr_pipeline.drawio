      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1" value="createConfiguredTesseractWorker(language, OEM=1, logger)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=19.5;" vertex="1" parent="1"><mxGeometry x="40" y="70.88888888888889" width="560" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s1_n" value="assertTesseractLanguagesAvailable() kiểm tra ngôn ngữ khả dụng; buildTesseractWorkerOptions() yêu cầu cả ba biến worker/core/lang phải được đặt cùng nhau" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="70.88888888888889" width="490" height="129.61111111111111" as="geometry"/></mxCell>
        <mxCell id="s2" value="setParameters({tessedit_pageseg_mode, tessedit_char_whitelist})" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=19.5;" vertex="1" parent="1"><mxGeometry x="40" y="212.66666666666666" width="560" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s2_n" value="PSM mặc định AUTO; danh sách ký tự cho phép do người dùng nhập" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="212.66666666666666" width="490" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s3" value="Nạp phông theo ngôn ngữ — getFontForLanguage()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=19.5;" vertex="1" parent="1"><mxGeometry x="40" y="354.44444444444446" width="560" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s3_n" value="languageToFontFamily ánh xạ ngôn ngữ sang họ phông; tách riêng phông Latin khi trộn chữ Latin với CJK/Ấn/Ả Rập; dự phòng Helvetica" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="354.44444444444446" width="490" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s4" value="Vòng lặp từng trang: pdfjs.getPage(i).render(scale = resolution)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=19.5;" vertex="1" parent="1"><mxGeometry x="40" y="496.2222222222222" width="560" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s4_n" value="Kết xuất trang ra canvas theo độ phân giải người dùng chọn" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="496.2222222222222" width="490" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s5" value="binarizeCanvas() — tuỳ chọn nhị phân hoá ngưỡng 128" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=19.5;" vertex="1" parent="1"><mxGeometry x="40" y="638.0" width="560" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s5_n" value="Độ sáng = 0,299R + 0,587G + 0,114B" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="638.0" width="490" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s6" value="recognizeWithTimeout(worker, canvas, 5 phút/trang)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=19.5;" vertex="1" parent="1"><mxGeometry x="40" y="779.7777777777777" width="560" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s6_n" value="Trả về text và hOCR; quá hạn được ghi thành cảnh báo thay vì huỷ toàn bộ tài liệu" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="779.7777777777777" width="490" height="113.42222222222222" as="geometry"/></mxCell>
