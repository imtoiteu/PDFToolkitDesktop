        <mxCell id="s7_n" value="Chuyển toạ độ hộp bao từ điểm ảnh sang điểm PDF" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="921.5555555555555" width="490" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s8" value="copyPages() trang gốc sang tài liệu mới (pdf-lib)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=19.5;" vertex="1" parent="1"><mxGeometry x="40" y="1063.3333333333333" width="560" height="113.42222222222222" as="geometry"/></mxCell>
        <mxCell id="s8_n" value="Giữ nguyên hình ảnh gốc, không kết xuất lại" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=17.7;" vertex="1" parent="1"><mxGeometry x="630" y="1063.3333333333333" width="490" height="113.42222222222222" as="geometry"/></mxCell>
